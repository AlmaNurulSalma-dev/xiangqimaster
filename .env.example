# XiangqiMaster — environment variables
# Copy to `.env` and fill in. `.env` is gitignored (never commit secrets).

# ─── Experiment tracking (Weights & Biases) ───────────────
WANDB_API_KEY=
WANDB_PROJECT=xiangqimaster
WANDB_ENTITY=

# ─── Paths (override defaults if needed) ──────────────────
DATA_DIR=data
RESULTS_DIR=results

# ─── Benchmark engine (compiled binary path) ──────────────
# ElephantEye (compile from https://github.com/xqbase/eleeye) or
# Pikafish (https://github.com/official-pikafish/Pikafish). Speaks UCCI.
ENGINE_PATH=src/environment/eleeye

# ─── Reproducibility ──────────────────────────────────────
GLOBAL_SEED=42
