# ─── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ─── Virtual environments ─────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Environment / secrets ────────────────────────────────
.env
*.local

# ─── Data (large, downloaded / derived — never commit) ────
data/raw/*
data/processed/*
# large persisted splits (reproducible from raw + seed)
data/splits/*.jsonl
!data/**/.gitkeep
# tiny; kept as the dataset-stats record for the thesis
!data/splits/dataset_manifest.json

# ─── Model checkpoints & large artifacts ──────────────────
results/checkpoints/*
!results/checkpoints/.gitkeep
*.pth
*.pt
*.pkl
*.ckpt
*.onnx

# ─── Experiment tracking / logs ───────────────────────────
wandb/
runs/
lightning_logs/
tensorboard/
*.log

# ─── Engine binaries (compiled ElephantEye / Pikafish) ────
src/environment/eleeye
src/environment/eleeye.exe
src/environment/pikafish
src/environment/pikafish.exe
*.bin

# ─── OS / editor ──────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
